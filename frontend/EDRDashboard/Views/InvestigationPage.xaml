<Page
    x:Class="EDRDashboard.Views.InvestigationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>

        <Grid Padding="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <Button
                        Content="← Back"
                        Click="BackButton_Click"
                        HorizontalAlignment="Left"/>

                    <TextBlock
                        Margin="0,20,0,0"
                        Text="{Binding Current.AlertTitle}"
                        FontSize="32"
                        FontWeight="Bold"/>

                    <TextBlock
                        Margin="0,5,0,0"
                        Text="{Binding Current.Time}"
                        Opacity="0.6"/>

                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="15,8"
                    CornerRadius="10"
                    Background="#B71C1C"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="{Binding Current.Severity}"
                        Foreground="White"
                        FontWeight="Bold"/>

                </Border>

            </Grid>

            <!-- Body -->

            <Grid
                Grid.Row="1"
                Margin="0,25,0,0"
                ColumnSpacing="20"
                RowSpacing="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="260"/>
                </Grid.RowDefinitions>

                <!-- AI -->

                <Border
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#404040">

                    <StackPanel>

                        <TextBlock
                            Text="AI Investigation Summary"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock
                            Margin="0,15,0,0"
                            TextWrapping="Wrap"
                            Text="{Binding Current.AiSummary}"/>

                    </StackPanel>

                </Border>

                <!-- Summary -->

                <Border
                    Grid.Column="1"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#404040">

                    <StackPanel>

                        <TextBlock
                            Text="Alert Summary"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock Margin="0,15,0,0">
                            <Run Text="Status : "/>
                            <Run Text="{Binding Current.Status}"/>
                        </TextBlock>

                        <TextBlock>
                            <Run Text="Technique : "/>
                            <Run Text="{Binding Current.Technique}"/>
                        </TextBlock>

                        <TextBlock>
                            <Run Text="Tactic : "/>
                            <Run Text="{Binding Current.Tactic}"/>
                        </TextBlock>

                    </StackPanel>

                </Border>

                <!-- MITRE -->

                <Border
                    Grid.Row="1"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#404040">

                    <StackPanel>

                        <TextBlock
                            Text="MITRE ATT&amp;CK"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock
                            Margin="0,15,0,0"
                            Text="{Binding Current.Technique}"/>

                        <TextBlock
                            Text="{Binding Current.Tactic}"/>

                    </StackPanel>

                </Border>

                <!-- Sigma -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#404040">

                    <StackPanel>

                        <TextBlock
                            Text="Sigma Rule"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock
                            Margin="0,15,0,0"
                            Text="{Binding Current.SigmaRule}"/>

                    </StackPanel>

                </Border>

                <!-- Steps -->

                <Border
                    Grid.Row="2"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#404040">

                    <StackPanel>

                        <TextBlock
                            Text="Investigation Steps"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock Margin="0,15,0,0"
                                   Text="✔ Decode PowerShell command"/>

                        <TextBlock
                            Text="✔ Review Parent Process"/>

                        <TextBlock
                            Text="✔ Review Child Processes"/>

                        <TextBlock
                            Text="✔ Review Network Activity"/>

                        <TextBlock
                            Text="✔ Isolate Endpoint"/>

                    </StackPanel>

                </Border>

                <!-- Raw Event -->

                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#404040">

                    <StackPanel>

                        <TextBlock
                            Text="Raw Sysmon Event"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock Margin="0,15,0,0">
                            <Run Text="Process : "/>
                            <Run Text="{Binding Current.Process}"/>
                        </TextBlock>

                        <TextBlock>
                            <Run Text="Parent : "/>
                            <Run Text="{Binding Current.ParentProcess}"/>
                        </TextBlock>

                        <TextBlock
                            TextWrapping="Wrap">
                            <Run Text="Command : "/>
                            <Run Text="{Binding Current.CommandLine}"/>
                        </TextBlock>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>