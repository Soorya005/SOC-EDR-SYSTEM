<Page
    x:Class="EDRDashboard.Views.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="Security Alerts"
                    FontSize="32"
                    FontWeight="Bold"/>

                <TextBlock
                    Margin="0,5,0,0"
                    Text="Monitor and investigate endpoint security events"
                    Opacity="0.7"/>

            </StackPanel>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                PlaceholderText="Search alerts..."
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged"/>

        </Grid>

        <!-- Filters -->

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,20,0,20"
            Spacing="10">

            <Button
                Content="All"
                MinWidth="90"
                Click="FilterAll_Click"/>

            <Button
                Content="Critical"
                MinWidth="90"
                Click="FilterCritical_Click"/>

            <Button
                Content="High"
                MinWidth="90"
                Click="FilterHigh_Click"/>

            <Button
                Content="Medium"
                MinWidth="90"
                Click="FilterMedium_Click"/>

            <Button
                Content="Low"
                MinWidth="90"
                Click="FilterLow_Click"/>

        </StackPanel>

        <!-- Alert List -->

        <ListView
            x:Name="AlertsList"
            Grid.Row="2"
            ItemsSource="{Binding Alerts}"
            SelectionChanged="AlertsList_SelectionChanged">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,6"
                        Padding="18"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#404040">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="150"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="170"/>

                                <ColumnDefinition Width="150"/>

                            </Grid.ColumnDefinitions>

                            <!-- Severity -->

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="Red"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="{Binding Severity}"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                            <!-- Alert -->

                            <StackPanel Grid.Column="1">

                                <TextBlock
                                    Text="{Binding Title}"
                                    FontSize="15"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="Windows Endpoint"
                                    FontSize="12"
                                    Opacity="0.6"/>

                            </StackPanel>

                            <!-- Status -->

                            <Border
                                Grid.Column="2"
                                Background="#1565C0"
                                CornerRadius="12"
                                Padding="10,4"
                                HorizontalAlignment="Left">

                                <TextBlock
                                    Text="{Binding Status}"
                                    Foreground="White"/>

                            </Border>

                            <!-- Time -->

                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding Time}"
                                VerticalAlignment="Center"
                                Opacity="0.75"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</Page>