<Page
    x:Class="EDRDashboard.Views.MitrePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">

            <TextBlock
                Text="MITRE ATT&amp;CK"
                FontSize="32"
                FontWeight="Bold"/>

            <TextBlock
                Text="Observed adversary techniques mapped from alerts"
                Opacity="0.7"/>

        </StackPanel>

        <ListView
            Grid.Row="1"
            ItemsSource="{Binding Techniques}">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,6"
                        Padding="18"
                        CornerRadius="12"
                        BorderBrush="#404040"
                        BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="{Binding TechniqueId}"
                                FontWeight="Bold"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Name}"/>

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding Tactic}"/>

                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding AlertCount}"/>

                            <TextBlock
                                Grid.Column="4"
                                Text="{Binding Severity}"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</Page>