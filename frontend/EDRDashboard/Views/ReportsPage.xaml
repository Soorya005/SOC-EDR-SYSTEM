<Page
    x:Class="EDRDashboard.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="4">
            <TextBlock
                Text="Reports"
                Style="{StaticResource SecurityTitleStyle}"/>
            <TextBlock
                Text="Generated security and investigation reports"
                Style="{StaticResource SecuritySubtitleStyle}"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center">

            <Button
                Content="+ Generate Daily Report"
                Style="{StaticResource PrimarySecurityButtonStyle}"
                Command="{Binding GenerateDailyReportCommand}"/>

            <Button
                Content="Export Selected"
                Style="{StaticResource SecurityButtonStyle}"
                Command="{Binding ExportCommand}"/>
        </StackPanel>

        <!-- Reports Table Panel -->
        <Border
            Grid.Row="2"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="20">

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Available Reports" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>

                <!-- Table Header -->
                <Grid Grid.Row="0" Margin="0,28,0,0" ColumnSpacing="12" Padding="12,0" Background="#161A22" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Report Name" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Type" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Generated By" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Created" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Status" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                </Grid>

                <!-- Reports List -->
                <ListView
                    x:Name="ReportsList"
                    Grid.Row="1"
                    ItemsSource="{Binding Reports}"
                    SelectedItem="{Binding SelectedReport, Mode=TwoWay}"
                    Padding="0"
                    Margin="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Report Name -->
                                    <TextBlock Text="{Binding ReportName}" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>

                                    <!-- Type -->
                                    <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center"/>

                                    <!-- Generated By -->
                                    <TextBlock Grid.Column="2" Text="{Binding GeneratedBy}" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center"/>

                                    <!-- Created -->
                                    <TextBlock Grid.Column="3" Text="{Binding Created}" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="4" 
                                            Background="Transparent" 
                                            BorderBrush="{Binding Status, Converter={StaticResource ReportStatusToColorConverter}}" 
                                            Style="{StaticResource SeverityBadgeStyle}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status}" 
                                                   Foreground="{Binding Status, Converter={StaticResource ReportStatusToColorConverter}}" 
                                                   FontSize="10" 
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>