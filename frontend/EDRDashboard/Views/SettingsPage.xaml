<Page
    x:Class="EDRDashboard.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>

        <Grid Padding="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>

                <TextBlock
                    Text="Settings"
                    FontSize="32"
                    FontWeight="Bold"/>

                <TextBlock
                    Margin="0,5,0,0"
                    Text="Configure the EDR Investigation Platform"
                    Opacity="0.7"/>

            </StackPanel>

            <!-- Backend -->

            <Border
                Grid.Row="1"
                Margin="0,25,0,0"
                Padding="20"
                CornerRadius="12"
                BorderBrush="#404040"
                BorderThickness="1">

                <StackPanel Spacing="15">

                    <TextBlock
                        Text="Backend"
                        FontSize="20"
                        FontWeight="Bold"/>

                    <TextBox
                        Header="API URL"
                        Text="http://localhost:8000"/>

                    <Button
                        Content="Test Connection"
                        HorizontalAlignment="Left"/>

                </StackPanel>

            </Border>

            <!-- AI -->

            <Border
                Grid.Row="2"
                Margin="0,20,0,0"
                Padding="20"
                CornerRadius="12"
                BorderBrush="#404040"
                BorderThickness="1">

                <StackPanel Spacing="15">

                    <TextBlock
                        Text="AI Configuration"
                        FontSize="20"
                        FontWeight="Bold"/>

                    <ComboBox
                        Header="LLM Provider"
                        SelectedIndex="0">

                        <ComboBoxItem Content="OpenAI"/>
                        <ComboBoxItem Content="Ollama"/>
                        <ComboBoxItem Content="Azure OpenAI"/>

                    </ComboBox>

                    <ToggleSwitch
                        Header="Enable AI Summary"
                        IsOn="True"/>

                </StackPanel>

            </Border>

            <!-- Appearance -->

            <Border
                Grid.Row="3"
                Margin="0,20,0,0"
                Padding="20"
                CornerRadius="12"
                BorderBrush="#404040"
                BorderThickness="1">

                <StackPanel Spacing="15">

                    <TextBlock
                        Text="Appearance"
                        FontSize="20"
                        FontWeight="Bold"/>

                    <ToggleSwitch
                        Header="Dark Mode"
                        IsOn="True"/>

                    <ToggleSwitch
                        Header="Show Notifications"
                        IsOn="True"/>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>