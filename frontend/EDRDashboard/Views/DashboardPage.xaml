<Page
    x:Class="EDRDashboard.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:EDRDashboard.Controls"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Security Overview"
                        Style="{StaticResource SecurityTitleStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Text="Real-time monitoring and threat detection"
                            Style="{StaticResource SecuritySubtitleStyle}"/>
                        <TextBlock
                            Text="|"
                            Style="{StaticResource SecuritySubtitleStyle}"/>
                        <TextBlock
                            Text="Last Updated:"
                            Style="{StaticResource SecuritySubtitleStyle}"/>
                        <TextBlock
                            Text="{Binding Stats.LastUpdated}"
                            Style="{StaticResource SecuritySubtitleStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Pills in Header -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="16"
                    VerticalAlignment="Center">

                    <controls:StatusIndicator
                        Text="Backend"
                        IsOnline="{Binding Stats.BackendOnline}"/>

                    <controls:StatusIndicator
                        Text="Database"
                        IsOnline="{Binding Stats.DatabaseOnline}"/>

                    <controls:StatusIndicator
                        Text="AI Engine"
                        IsOnline="{Binding Stats.AiOnline}"/>

                    <controls:StatusIndicator
                        Text="Sysmon"
                        IsOnline="{Binding Stats.SysmonRunning}"/>
                </StackPanel>
            </Grid>

            <!-- Statistics Cards Row -->
            <Grid
                Grid.Row="1"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:StatisticCard
                    Grid.Column="0"
                    Title="Total Alerts"
                    Value="{Binding Stats.TotalAlerts}"
                    Accent="{StaticResource HighBrush}"/>

                <controls:StatisticCard
                    Grid.Column="1"
                    Title="Critical Alerts"
                    Value="{Binding Stats.CriticalAlerts}"
                    Accent="{StaticResource CriticalBrush}"/>

                <controls:StatisticCard
                    Grid.Column="2"
                    Title="Active Incidents"
                    Value="{Binding Stats.ActiveIncidents}"
                    Accent="{StaticResource AccentCyanBrush}"/>

                <controls:StatisticCard
                    Grid.Column="3"
                    Title="Monitored Endpoints"
                    Value="{Binding Stats.MonitoredEndpoints}"
                    Accent="{StaticResource HealthyBrush}"/>
            </Grid>

            <!-- Main Body Layout -->
            <Grid
                Grid.Row="2"
                ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Chart & Recent Alerts Table -->
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Alert Activity Chart -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="Alert Activity"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="White"/>
                                    <TextBlock
                                        Text="Security alerts detected over time"
                                        FontSize="12"
                                        Foreground="#6B7280"/>
                                </StackPanel>

                                <!-- Duration Badges -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Background="#161A22" CornerRadius="2" Padding="8,4" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                                        <TextBlock Text="1H" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#002D3D" CornerRadius="2" Padding="8,4" BorderThickness="1" BorderBrush="{StaticResource AccentCyanBrush}">
                                        <TextBlock Text="24H" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#161A22" CornerRadius="2" Padding="8,4" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                                        <TextBlock Text="7D" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <lvc:CartesianChart
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                Series="{Binding AlertTrendSeries}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}" />
                        </Grid>
                    </Border>

                    <!-- Recent Alerts Table Card -->
                    <Border
                        Grid.Row="1"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">

                        <StackPanel Spacing="16">
                            <TextBlock
                                Text="Recent Alerts"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"/>

                            <!-- Table Header -->
                            <Grid ColumnSpacing="12" Padding="12,0" Background="#161A22" Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Severity" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Alert Title" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Host" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Status" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Time" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Table Rows (ListView) -->
                            <ListView
                                x:Name="RecentAlertsList"
                                ItemsSource="{Binding RecentAlerts}"
                                SelectionMode="Single"
                                SelectionChanged="RecentAlertsList_SelectionChanged"
                                Padding="0"
                                Margin="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Severity Badge -->
                                                <Border Background="Transparent" 
                                                        BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}" 
                                                        Style="{StaticResource SeverityBadgeStyle}">
                                                    <TextBlock Text="{Binding Severity}" 
                                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}" 
                                                               FontSize="10" 
                                                               FontWeight="Bold"/>
                                                </Border>

                                                <!-- Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>

                                                <!-- Host (Fallback to Endpoint or hardcoded if empty) -->
                                                <TextBlock Grid.Column="2" Text="{Binding Endpoint}" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center"/>

                                                <!-- Status -->
                                                <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center"/>

                                                <!-- Time (Format string) -->
                                                <TextBlock Grid.Column="4" Text="{Binding Time}" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Right Column: Severity Breakdown & System Health -->
                <StackPanel Grid.Column="1" Spacing="20">
                    
                    <!-- Threat Severity breakdown Card -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">

                        <StackPanel Spacing="16">
                            <TextBlock
                                Text="Threat Severity"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"/>

                            <StackPanel Spacing="12">
                                <!-- Critical -->
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="Critical" FontSize="12" Foreground="White" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding CriticalCount}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource CriticalBrush}" FontWeight="Bold"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding CriticalPercent}" Minimum="0" Maximum="100" Height="4" Foreground="{StaticResource CriticalBrush}" Background="#1F1F2E"/>
                                </StackPanel>

                                <!-- High -->
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="High" FontSize="12" Foreground="White" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding HighCount}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource HighBrush}" FontWeight="Bold"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding HighPercent}" Minimum="0" Maximum="100" Height="4" Foreground="{StaticResource HighBrush}" Background="#1F1F2E"/>
                                </StackPanel>

                                <!-- Medium -->
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="Medium" FontSize="12" Foreground="White" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding MediumCount}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MediumBrush}" FontWeight="Bold"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding MediumPercent}" Minimum="0" Maximum="100" Height="4" Foreground="{StaticResource MediumBrush}" Background="#1F1F2E"/>
                                </StackPanel>

                                <!-- Low -->
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="Low" FontSize="12" Foreground="White" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding LowCount}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource LowBrush}" FontWeight="Bold"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding LowPercent}" Minimum="0" Maximum="100" Height="4" Foreground="{StaticResource LowBrush}" Background="#1F1F2E"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- System Health Card -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">

                        <StackPanel Spacing="16">
                            <TextBlock
                                Text="System Health"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"/>

                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="Backend" Foreground="#9CA3AF" FontSize="13"/>
                                    <TextBlock Text="{Binding Stats.BackendOnline, Converter={StaticResource OnlineStatusToTextConverter}}" Foreground="{Binding Stats.BackendOnline, Converter={StaticResource OnlineStatusToColorConverter}}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Database" Foreground="#9CA3AF" FontSize="13"/>
                                    <TextBlock Text="{Binding Stats.DatabaseOnline, Converter={StaticResource OnlineStatusToTextConverter}}" Foreground="{Binding Stats.DatabaseOnline, Converter={StaticResource OnlineStatusToColorConverter}}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="AI Engine" Foreground="#9CA3AF" FontSize="13"/>
                                    <!-- Use status color depending on dynamic binding -->
                                    <TextBlock Text="{Binding Stats.AiOnline, Converter={StaticResource OnlineStatusToTextConverter}}" Foreground="{Binding Stats.AiOnline, Converter={StaticResource OnlineStatusToColorConverter}}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" x:Name="AiHealthText"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Sysmon" Foreground="#9CA3AF" FontSize="13"/>
                                    <TextBlock Text="{Binding Stats.SysmonRunning, Converter={StaticResource OnlineStatusToTextConverter}}" Foreground="{Binding Stats.SysmonRunning, Converter={StaticResource OnlineStatusToColorConverter}}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>