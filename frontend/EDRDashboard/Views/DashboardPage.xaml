<Page
    x:Class="EDRDashboard.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:EDRDashboard.Controls"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Padding="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock
                        Text="SOC EDR Investigation Platform"
                        FontSize="34"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Real-time Endpoint Detection &amp; Response"
                        Opacity="0.7"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="{Binding Stats.LastUpdated}"
                        Opacity="0.6"/>

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Spacing="10">

                    <controls:StatusIndicator
    Text="Backend API"
    IsOnline="{Binding Stats.BackendOnline}"/>

                    <controls:StatusIndicator
    Text="Database"
    IsOnline="{Binding Stats.DatabaseOnline}"/>

                    <controls:StatusIndicator
    Text="AI Engine"
    IsOnline="{Binding Stats.AiOnline}"/>

                    <controls:StatusIndicator
    Text="Sysmon"
    IsOnline="{Binding Stats.SysmonRunning}"/>

                </StackPanel>

            </Grid>

            <!-- Statistics -->

            <Grid
                Grid.Row="1"
                Margin="0,25,0,25"
                ColumnSpacing="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <controls:StatisticCard
                    Grid.Column="0"
                    Title="Total Alerts"
                    Value="{Binding Stats.TotalAlerts}"
                    Accent="OrangeRed"/>

                <controls:StatisticCard
                    Grid.Column="1"
                    Title="Critical Alerts"
                    Value="{Binding Stats.CriticalAlerts}"
                    Accent="Red"/>

                <controls:StatisticCard
                    Grid.Column="2"
                    Title="Active Incidents"
                    Value="{Binding Stats.ActiveIncidents}"
                    Accent="DodgerBlue"/>

                <controls:StatisticCard
                    Grid.Column="3"
                    Title="Endpoints"
                    Value="{Binding Stats.MonitoredEndpoints}"
                    Accent="LimeGreen"/>

            </Grid>

            <!-- Body -->

            <Grid
                Grid.Row="2"
                ColumnSpacing="20"
                RowSpacing="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="250"/>
                    <RowDefinition Height="250"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <!-- Alert Trend -->

                <Border
    Grid.Row="0"
    Grid.Column="0"
    Padding="20"
    CornerRadius="12"
    BorderBrush="#404040"
    BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock
            Text="Alert Trend"
            FontSize="20"
            FontWeight="Bold"/>

                        <lvc:CartesianChart
            Grid.Row="1"
            Margin="0,20,0,0"
            Series="{Binding AlertTrendSeries}"
            XAxes="{Binding XAxes}"
            YAxes="{Binding YAxes}" />

                    </Grid>

                </Border>

                <!-- Recent Alerts -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="20"
                    CornerRadius="12"
                    BorderBrush="#404040"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            Text="Recent Alerts"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock Margin="0,15,0,0">🔴 Encoded PowerShell</TextBlock>
                        <TextBlock>🟠 LSASS Memory Access</TextBlock>
                        <TextBlock>🟡 Registry Persistence</TextBlock>
                        <TextBlock>🟢 WMI Execution</TextBlock>

                    </StackPanel>

                </Border>

                <!-- MITRE -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="20"
                    CornerRadius="12"
                    BorderBrush="#404040"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            Text="Top MITRE ATT&amp;CK Techniques"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock Margin="0,15,0,0">T1059.001 - PowerShell</TextBlock>
                        <TextBlock>T1003 - Credential Dumping</TextBlock>
                        <TextBlock>T1547 - Registry Run Keys</TextBlock>
                        <TextBlock>T1105 - Ingress Tool Transfer</TextBlock>

                    </StackPanel>

                </Border>

                <!-- System Health -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="20"
                    CornerRadius="12"
                    BorderBrush="#404040"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            Text="System Health"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock Margin="0,15,0,0">🟢 Backend Online</TextBlock>
                        <TextBlock>🟢 Database Connected</TextBlock>
                        <TextBlock>🟢 AI Engine Ready</TextBlock>
                        <TextBlock>🟢 Sysmon Running</TextBlock>

                    </StackPanel>

                </Border>

                <!-- Activity -->

                <Border
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Padding="20"
                    CornerRadius="12"
                    BorderBrush="#404040"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            Text="Activity Feed"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock Margin="0,15,0,0">
                            16:42 - Critical PowerShell alert detected.
                        </TextBlock>

                        <TextBlock>
                            16:20 - LSASS access investigation started.
                        </TextBlock>

                        <TextBlock>
                            15:58 - Registry persistence alert escalated.
                        </TextBlock>

                        <TextBlock>
                            15:30 - WMI execution alert closed.
                        </TextBlock>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>