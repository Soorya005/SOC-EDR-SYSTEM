<UserControl
    x:Class="EDRDashboard.Controls.StatisticCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
    x:Name="CardBorder"
    CornerRadius="12"
    Padding="20"
    BorderThickness="1"
    BorderBrush="#505050"
    Background="#252526">

        <StackPanel>

            <TextBlock
                x:Name="TitleText"
                Text="Title"
                FontSize="14"
                Opacity="0.75"/>

            <TextBlock
                x:Name="ValueText"
                Margin="0,10,0,0"
                Text="0"
                FontSize="34"
                FontWeight="Bold"/>

            <Rectangle
                x:Name="AccentBar"
                Margin="0,15,0,0"
                Height="4"
                Width="60"
                RadiusX="2"
                RadiusY="2"
                Fill="DodgerBlue"/>

        </StackPanel>

    </Border>

</UserControl>