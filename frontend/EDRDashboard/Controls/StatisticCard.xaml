<UserControl
    x:Class="EDRDashboard.Controls.StatisticCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="CardBorder"
        CornerRadius="4"
        Padding="18,16"
        BorderThickness="1"
        BorderBrush="#1E222B"
        Background="#12141C">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Vertical accent line on the left -->
            <Rectangle
                x:Name="AccentBar"
                Width="3"
                RadiusX="1"
                RadiusY="1"
                Fill="DodgerBlue"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Margin="0,2,12,2"/>

            <StackPanel Grid.Column="1">
                <TextBlock
                    x:Name="TitleText"
                    Text="Title"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#9CA3AF"
                    CharacterSpacing="0.5"/>

                <TextBlock
                    x:Name="ValueText"
                    Margin="0,6,0,0"
                    Text="0"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>