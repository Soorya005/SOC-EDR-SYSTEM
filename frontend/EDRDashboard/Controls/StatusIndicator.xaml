<UserControl
    x:Class="EDRDashboard.Controls.StatusIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        Orientation="Horizontal"
        Spacing="8">

        <Ellipse
            x:Name="StatusDot"
            Width="10"
            Height="10"
            Fill="LimeGreen"/>

        <TextBlock
            x:Name="StatusText"
            Text="Online"
            VerticalAlignment="Center"/>

    </StackPanel>

</UserControl>