<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->

    <SolidColorBrush x:Key="CardBackgroundBrush"
                     Color="#252526"/>

    <SolidColorBrush x:Key="CardBorderBrush"
                     Color="#4B4B4B"/>

    <SolidColorBrush x:Key="CriticalBrush"
                     Color="#E74C3C"/>

    <SolidColorBrush x:Key="HighBrush"
                     Color="#F39C12"/>

    <SolidColorBrush x:Key="MediumBrush"
                     Color="#3498DB"/>

    <SolidColorBrush x:Key="SuccessBrush"
                     Color="#2ECC71"/>

    <SolidColorBrush x:Key="TitleBrush"
                     Color="White"/>

    <SolidColorBrush x:Key="SubtitleBrush"
                     Color="#B0B0B0"/>

</ResourceDictionary>